# ==============================================================================
# ViralKamFlow Environment Configuration (.env.example)
# ==============================================================================
# Note: Copy this file to .env.local to configure local or deployment credentials.
# Do NOT commit sensitive keys to version control.

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
# Base URL of your deployed application or local environment (NO trailing slash).
NEXT_PUBLIC_APP_URL=https://viralkamflow.vercel.app

# ------------------------------------------------------------------------------
# 2. Meta Developer App (Facebook & Unified Login Base)
# ------------------------------------------------------------------------------
# Found in: Meta for Developers (developers.facebook.com) -> Your App -> App Settings -> Basic
# - Meta App ID: Visible at top bar and under Basic settings.
# - Meta App Secret: Click 'Show' next to App Secret.
META_CLIENT_ID=
META_CLIENT_SECRET=

# Optional dedicated redirect URI override (defaults to ${NEXT_PUBLIC_APP_URL}/api/oauth/facebook/callback)
FACEBOOK_REDIRECT_URI=https://viralkamflow.vercel.app/api/oauth/facebook/callback

# ------------------------------------------------------------------------------
# 3. Instagram API with Unified Login
# ------------------------------------------------------------------------------
# In Meta Developer Dashboard:
# Go to: Use Cases -> Manage messaging & content on Instagram -> API setup with Unified login
# Configuration Complete gives you your unique Configuration ID (config_id).
#
# IMPORTANT: Instagram API with Unified Login uses the Meta App ID & Secret above.
# A separate INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET is NOT required for Unified Login.
INSTAGRAM_CONFIG_ID=

# Optional dedicated redirect URI override (defaults to ${NEXT_PUBLIC_APP_URL}/api/oauth/instagram/callback)
INSTAGRAM_REDIRECT_URI=https://viralkamflow.vercel.app/api/oauth/instagram/callback

# ------------------------------------------------------------------------------
# 4. Threads API
# ------------------------------------------------------------------------------
# Found in: Meta for Developers -> Use cases -> Threads API -> Settings (or App Settings)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional dedicated redirect URI override (defaults to ${NEXT_PUBLIC_APP_URL}/api/oauth/threads/callback)
THREADS_REDIRECT_URI=https://viralkamflow.vercel.app/api/oauth/threads/callback

# ------------------------------------------------------------------------------
# 5. Database Storage (Cloudflare D1 & Supabase)
# ------------------------------------------------------------------------------
# Cloudflare D1 Serverless Database (Primary persistent storage)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Supabase (Optional fallback database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
